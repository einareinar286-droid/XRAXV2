{
  "bsonType": "object",
  "description": "uni-id 用户表（opendb 兼容，server-only）。假账号测试阶段仅存匿名测试用户。",
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "required": ["username", "passwordHash"],
  "properties": {
    "_id": {
      "description": "用户 uid"
    },
    "username": {
      "bsonType": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "用户名（唯一）"
    },
    "passwordHash": {
      "bsonType": "string",
      "description": "密码散列（HMAC-SHA256，绝不明文）"
    },
    "passwordSecretVersion": {
      "bsonType": "int",
      "description": "密码散列算法版本"
    },
    "displayName": {
      "bsonType": "string",
      "description": "显示名称（匿名）"
    },
    "department": {
      "bsonType": "string",
      "description": "部门（匿名）"
    },
    "role": {
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      },
      "description": "角色列表：SUPER_ADMIN / SAFETY_OFFICER / MARKETING_OFFICER / EMPLOYEE"
    },
    "token": {
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      },
      "description": "已签发 token（uni-id-common 维护）"
    },
    "status": {
      "bsonType": "int",
      "description": "账号状态：0 正常 / 1 封禁 / 4 注销"
    },
    "valid_token_date": {
      "bsonType": "timestamp",
      "description": "该时间之前的 token 全部失效"
    },
    "last_login_ip": {
      "bsonType": "string"
    },
    "last_login_date": {
      "bsonType": "timestamp"
    },
    "createdAt": {
      "bsonType": "timestamp"
    },
    "updatedAt": {
      "bsonType": "timestamp"
    }
  }
}
