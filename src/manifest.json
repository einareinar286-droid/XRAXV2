  },
  "app-plus": {
    "usingComponents": true,
    "distribute": {
      "android": {
        "permissions": ["android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"]
      },
      "ios": {
        "privacyDescription": {
          "NSLocationWhenInUseUsageDescription": "用于记录现场隐患位置，便于整改闭环。"
        }
      }
    }
  }
}
